# Puerto del Gateway
PORT=3000
NODE_ENV=development

# Seguridad JWT (mínimo 32 caracteres). Debe ser IDÉNTICO al JWT_SECRET de
# auth-service (ver apps/auth-service/.env.example): el gateway verifica con
# esta clave los access tokens que auth-service firma con la suya.
JWT_SECRET=uajs_dev_jwt_secret_1234567890abcdefghijklmnopqrstuvwxyz_extra_long_654321

# Secreto compartido con TODOS los microservicios internos (mínimo 32
# caracteres). Debe tener el mismo valor en el .env de cada servicio, para
# que puedan verificar que una petición con X-User-Id/X-User-Roles vino de
# verdad del gateway.
SERVICE_AUTH_TOKEN=uajs_service_token_2024_change_me_in_prod

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://campus.uajs.edu.co

# Rate Limiting (Token Bucket)
RATE_LIMIT_BUCKET_CAPACITY=100
RATE_LIMIT_REFILL_PER_SEC=10

# URLs de Microservicios Internos
SERVICE_AUTH_URL=http://auth-service:3001
SERVICE_USER_URL=http://user-service:3002
SERVICE_CATALOG_URL=http://catalog-service:3003
SERVICE_UNIVERSITY_URL=http://university-service:3004
SERVICE_RESOURCE_URL=http://resource-service:3005
SERVICE_BOOKING_URL=http://booking-service:3006
SERVICE_REQUEST_URL=http://request-service:3007
SERVICE_EVENT_URL=http://event-service:3008
SERVICE_NOTIFICATION_URL=http://notification-service:3009
SERVICE_PQRS_URL=http://pqrs-service:3010
SERVICE_STORAGE_URL=http://storage-service:3011

# Elasticsearch
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_USER=elastic
ELASTICSEARCH_PASSWORD=changeme