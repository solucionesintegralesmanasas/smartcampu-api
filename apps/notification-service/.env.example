NODE_ENV=development
PORT=3009
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=uajs_user
MYSQL_PASSWORD=uajs206**
MYSQL_DATABASE=uajs_notifications
REDIS_HOST=redis
REDIS_PORT=6379
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200
# Cola compartida: booking/request/event/pqrs-service publican aquí sus
# eventos de dominio notificables (job.name = 'domain_event'). Debe
# coincidir con el valor por defecto usado en esos 4 servicios.
NOTIFICATION_QUEUE=notification_events
NOTIFICATION_INDEX=uajs_notifications
NOTIFICATION_CACHE_TTL=3600
# Debe coincidir con el SERVICE_AUTH_TOKEN del api-gateway y de los demás servicios.
SERVICE_AUTH_TOKEN=uajs_service_token_2024_change_me_in_prod
