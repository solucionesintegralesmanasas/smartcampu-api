NODE_ENV=development
PORT=3009
JWT_SECRET=super_secret_key_minimum_64_characters_long_for_security_purposes_here
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=uajs_user
MYSQL_PASSWORD=changeme
MYSQL_DATABASE=uajs_notifications
REDIS_HOST=redis
REDIS_PORT=6379
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200
# Cola de entregas (correo/push) y concurrencia de los workers
NOTIFICATION_DELIVERY_QUEUE=uajs.notificaciones.entregas.v1
NOTIFICATION_WORKER_CONCURRENCY=5
# Driver de canal de entrega: 'log' simula el envío sin proveedor externo
NOTIFICATION_CHANNEL_DRIVER=log
# Segundos que se conserva un evento procesado para garantizar idempotencia
NOTIFICATION_IDEMPOTENCY_TTL=604800
NOTIFICATION_EVENTS_INDEX=uajs_notifications_events
CORS_ALLOWED_ORIGINS=http://localhost:3000
