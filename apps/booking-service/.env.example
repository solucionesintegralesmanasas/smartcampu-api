SERVICE_AUTH_TOKEN=uajs_service_token_2024_change_me_in_prod
# Usado para validar existencia y disponibilidad operativa de un recurso
# antes de confirmar una reserva.
SERVICE_RESOURCE_URL=http://resource-service:3005
