NODE_ENV=development
PORT=3006
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=uajs_user
MYSQL_PASSWORD=uajs206**
MYSQL_DATABASE=uajs_bookings
REDIS_HOST=redis
REDIS_PORT=6379
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200
BOOKING_QUEUE=booking_events
BOOKING_INDEX=uajs_bookings
