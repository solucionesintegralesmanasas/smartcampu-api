NODE_ENV=development
PORT=3011
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=uajs_user
MYSQL_PASSWORD=uajs206**
MYSQL_DATABASE=uajs_storage
REDIS_HOST=redis
REDIS_PORT=6379
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200
STORAGE_QUEUE=storage_events
STORAGE_INDEX=uajs_storage
STORAGE_CACHE_TTL=3600
# Backend de almacenamiento del contenido binario. Por ahora solo existe
# 'local' (disco); STORAGE_PATH es relativo a la raíz del servicio si no es
# una ruta absoluta.
STORAGE_DRIVER=local
STORAGE_PATH=./uploads
# 10 MB en bytes
STORAGE_MAX_SIZE=10485760
# Debe coincidir con el SERVICE_AUTH_TOKEN del api-gateway y de los demás servicios.
SERVICE_AUTH_TOKEN=uajs_service_token_2024_change_me_in_prod
