NODE_ENV=development
PORT=3001
# Debe ser IDÉNTICO al JWT_SECRET de api-gateway (ver
# apps/api-gateway/.env.example): el gateway verifica con esa misma clave
# los access tokens que este servicio firma.
JWT_SECRET=uajs_dev_jwt_secret_1234567890abcdefghijklmnopqrstuvwxyz_extra_long_654321
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_SECRET=uajs_dev_jwt_refresh_secret_abcdefghijklmnopqrstuvwxyz_9876543210_largo
BCRYPT_ROUNDS=12
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=uajs_user
MYSQL_PASSWORD=uajs206**
MYSQL_DATABASE=uajs_auth
REDIS_HOST=redis
REDIS_PORT=6379
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200
EMAIL_QUEUE=auth_emails
AUTH_EVENTS_INDEX=uajs_auth_events
# SMTP opcional: sin SMTP_HOST, los correos solo se registran en logs (no se envían de verdad).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=UAJS Smart Campus <no-reply@uajs.edu>
PASSWORD_RESET_URL_BASE=http://localhost:3000/reset-password