NODE_ENV=development
PORT=3010
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=uajs_user
MYSQL_PASSWORD=uajs206**
MYSQL_DATABASE=uajs_pqrs
REDIS_HOST=redis
REDIS_PORT=6379
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200
PQRS_QUEUE=pqrs_events
PQRS_INDEX=uajs_pqrs
PQRS_CACHE_TTL=3600
# Cola compartida que escucha notification-service (no PQRS_QUEUE).
NOTIFICATION_QUEUE=notification_events
# Debe coincidir con el SERVICE_AUTH_TOKEN del api-gateway y de los demás servicios.
SERVICE_AUTH_TOKEN=uajs_service_token_2024_change_me_in_prod
# Usado para validar que un archivo adjunto existe y pertenece al usuario
# que lo está enganchando a una PQRS.
SERVICE_STORAGE_URL=http://storage-service:3011
