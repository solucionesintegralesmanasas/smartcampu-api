NODE_ENV=development
PORT=3002
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=uajs_user
MYSQL_PASSWORD=uajs206**
# Comparte la base de auth-service: users/persons/roles/permissions ya viven ahí.
MYSQL_DATABASE=uajs_auth
REDIS_HOST=redis
REDIS_PORT=6379
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200
USER_QUEUE=user_events
USER_INDEX=uajs_users
USER_CACHE_TTL=3600
# Debe coincidir con el SERVICE_AUTH_TOKEN del api-gateway y de los demás servicios.
SERVICE_AUTH_TOKEN=uajs_service_token_2024_change_me_in_prod
# Opcional hasta que exista university-service (Fase 2): si no está seteada,
# el perfil polimórfico degrada a { tipo: 'basico' } sin fallar.
SERVICE_UNIVERSITY_URL=http://university-service:3004
