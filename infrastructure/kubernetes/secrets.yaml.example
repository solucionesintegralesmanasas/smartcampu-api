# ============================================================
# PLANTILLA de secretos — copiar a secrets.yaml, reemplazar
# TODOS los valores de ejemplo por unos reales/generados
# (ver `npm run generate:secrets` en la raíz del monorepo), y
# NUNCA versionar secrets.yaml (agregarlo a .gitignore).
#
# Aplicar con: kubectl apply -f secrets.yaml
# ============================================================
apiVersion: v1
kind: Secret
metadata:
  name: uajs-shared-secrets
  namespace: uajs-smart-campus
type: Opaque
stringData:
  MYSQL_ROOT_PASSWORD: 'CHANGE_ME_root_password'
  MYSQL_PASSWORD: 'CHANGE_ME_app_user_password'
  REDIS_PASSWORD: ''
  ELASTICSEARCH_PASSWORD: 'CHANGE_ME_elastic_password'
  # Compartido entre api-gateway y los 11 servicios internos: valida que
  # una petición realmente pasó por el gateway (ver AGENTS.md).
  SERVICE_AUTH_TOKEN: 'CHANGE_ME_min_32_characters_service_token'
  JWT_SECRET: 'CHANGE_ME_min_32_characters_jwt_access_secret'
  JWT_REFRESH_SECRET: 'CHANGE_ME_min_32_characters_jwt_refresh_secret'
  SMTP_HOST: ''
  SMTP_PORT: '587'
  SMTP_USER: ''
  SMTP_PASS: ''
