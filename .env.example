# Node Environment
NODE_ENV=development
PORT=3000

# Database
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=uajs_user
MYSQL_PASSWORD=uajs206**
MYSQL_DATABASE=uajs_smart_campus
DB_POOL_MIN=2
DB_POOL_MAX=10

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_ACCESS_SECRET=change_this_in_production_32chars_min
JWT_REFRESH_SECRET=change_this_in_production_32chars_min
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Service Authentication
SERVICE_AUTH_TOKEN=uajs_service_auth_token_example_32chars

# SMTP (Email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notifications@uajs.edu
SMTP_PASS=app_password_here

# Storage
STORAGE_DRIVER=local
STORAGE_PATH=./uploads
STORAGE_MAX_SIZE=10485760

# Gateway
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://campus.uajs.edu
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX=100

# Redis Queues
QUEUE_ATTEMPTS=3
QUEUE_BACKOFF_DELAY=2000
DEAD_LETTER_QUEUE=failed

# Monitoring
LOG_LEVEL=info
REQUEST_ID_HEADER=X-Request-Id
SERVICE_NAME=uajs-smart-campus

# Elasticsearch
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_USER=elastic
ELASTICSEARCH_PASSWORD=changeme
ELASTICSEARCH_API_VERSION=8.12

# Kubernetes / Docker
KUBERNETES_NAMESPACE=default
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=5