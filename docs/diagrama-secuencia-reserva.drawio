          <mxGeometry x="600" y="50" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p5" value="&lt;b&gt;MySQL&lt;/b&gt;&lt;br&gt;uajs_bookings" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#15803D;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="790" y="50" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p6" value="&lt;b&gt;MySQL&lt;/b&gt;&lt;br&gt;uajs_resources" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#15803D;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="980" y="50" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p7" value="&lt;b&gt;Elasticsearch&lt;/b&gt;&lt;br&gt;:9200" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#6D28D9;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1170" y="50" width="170" height="60" as="geometry" />
        </mxCell>

