          <mxGeometry relative="1" as="geometry"><mxPoint x="115" y="110" as="sourcePoint" /><mxPoint x="115" y="1250" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="l2" style="endArrow=none;dashed=1;html=1;strokeColor=#9CA3AF;strokeWidth=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="305" y="110" as="sourcePoint" /><mxPoint x="305" y="1250" as="targetPoint" /></mxGeometry>
        </mxCell>
